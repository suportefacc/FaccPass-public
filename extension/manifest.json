{
  "manifest_version": 3,
  "name": "FaccPass - Gerenciador de Senhas Empresarial",
  "version": "1.0.1",
  "description": "Gerenciador de senhas empresarial seguro para sua organização",
  "homepage_url": "https://suportefacc.github.io/FaccPass-public/",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "http://200.20.100.25:5011/*",
    "http://localhost:5011/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/facc-inicial.png",
      "48": "icons/facc-inicial.png",
      "128": "icons/facc-inicial.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/facc-inicial.png",
    "48": "icons/facc-inicial.png",
    "128": "icons/facc-inicial.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}